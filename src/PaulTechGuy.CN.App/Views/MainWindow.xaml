<Window
    x:Class="PaulTechGuy.CN.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PaulTechGuy.CN.Presentation"
    xmlns:domain="using:PaulTechGuy.CN.Domain"
    xmlns:local="using:PaulTechGuy.CN.App">

    <!--
        The whole window accepts a drop, not just the file list. When the list is empty
        there is no obvious target to aim at, and a drop that lands on the wrong pane and
        does nothing teaches people the feature does not exist.
    -->
    <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto"
          AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" DragLeave="OnDragLeave">

        <!--
            ONE flyout, shared by every row, rather than one declared inside the row
            template. A template-level flyout is built for each realised container and
            rebuilt on every recycle, which is a lot of objects for a menu only ever shown
            once at a time. The handler records which row was clicked before showing it.

            Everything here acts on the right-clicked row and nothing else, whatever is
            ticked. A menu item that sometimes means "this file" and sometimes means "these
            three hundred" is how somebody removes three hundred files by accident.
        -->
        <Grid.Resources>
            <MenuFlyout x:Name="RowMenu">
                <MenuFlyoutItem Text="Open" Click="OnRowMenuOpen" />
                <MenuFlyoutItem Text="Show in File Explorer" Click="OnRowMenuShowInExplorer" />
                <MenuFlyoutItem Text="Copy full path" Click="OnRowMenuCopyPath" />
                <MenuFlyoutItem Text="Properties" Click="OnRowMenuProperties" />

                <MenuFlyoutSeparator />

                <MenuFlyoutItem Text="Create a copy" Click="OnRowMenuCreateCopy" />

                <MenuFlyoutSeparator />

                <!-- Text is set when the menu opens, because it names what the click does. -->
                <MenuFlyoutItem Tag="tick" Text="Include in the run" Click="OnRowMenuToggle" />
                <MenuFlyoutItem Text="Run on this file only" Click="OnRowMenuSelectOnly" />
                <MenuFlyoutItem Text="Remove from the list" Click="OnRowMenuRemove" />

                <MenuFlyoutSeparator />

                <MenuFlyoutItem Text="Set this file's date…" Click="OnRowMenuSetDate" />
                <MenuFlyoutItem Tag="clear" Text="Use the run's date again" Click="OnRowMenuClearDate" />
                <MenuFlyoutItem Text="Use this file's date for the run" Click="OnRowMenuUseDate" />
            </MenuFlyout>
        </Grid.Resources>


        <!--
            The title bar carries no controls. It used to hold a File dates / Photo dates
            switch, which was redundant with the options pane and could actively contradict
            it: choosing a photo preset set the switch, but moving the switch did not clear
            the preset. One question, asked once, in one place.
        -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="16,0">
            <TextBlock Text="Chronora" VerticalAlignment="Center"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,320">

            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16,0,8,0">

                <!--
                    The summary band IS the preview. Six lines someone can actually verify
                    beats 4,000 rows they cannot, and it is what makes a batch of 63 videos
                    landing on 1904 visible without scrolling to find them.
                -->
                <!--
                    Hidden entirely until there is something to summarise. An empty card
                    reading "0 of 0 will change" is worse than no card: it occupies the most
                    prominent place on screen to say nothing, right when the pane should be
                    inviting the first drop instead.
                -->
                <Border Grid.Row="0" Padding="12,8" CornerRadius="4" Margin="0,0,0,8"
                        Visibility="{x:Bind Workbench.HasAnyFiles, Mode=OneWay}"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <StackPanel Spacing="2">
                        <ItemsControl ItemsSource="{x:Bind Workbench.Summary.Lines, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SummaryLine">
                                    <Grid ColumnDefinitions="110,*,Auto">
                                        <TextBlock Grid.Column="0" Text="{x:Bind FieldName}"
                                                   Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Detail}"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind SuspiciousDetail}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!--
                            Fields that were asked for and will NOT happen, shown as
                            prominently as the ones that will. Omitting them was the exact
                            failure the destination presets exist to prevent: tick a field,
                            see a clean summary, and learn nothing about why it did nothing.
                        -->
                        <ItemsControl ItemsSource="{x:Bind Workbench.Summary.BlockedLines, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BlockedLine">
                                    <Grid ColumnDefinitions="110,*">
                                        <TextBlock Grid.Column="0" Text="{x:Bind FieldName}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Detail}"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{x:Bind Workbench.Summary.StatusLine, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Spacing="6">
                    <!--
                        What the last drop did, offered back rather than assumed. A drop
                        adds, because gathering is almost always the intent, and both
                        alternatives sit right here while the bar is up. No dialog on an
                        action people repeat.
                    -->
                    <InfoBar IsOpen="{x:Bind Workbench.HasActionNotice, Mode=OneWay}"
                             Message="{x:Bind Workbench.ActionNotice, Mode=OneWay}"
                             Severity="Success" IsClosable="True" CloseButtonClick="OnDismissActionNotice">
                        <!-- ActionButton takes a single button, so both alternatives live
                             in the content area where they can sit side by side. -->
                        <InfoBar.Content>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,8">
                                <!-- Only when the drop landed on top of something. Replacing
                                     an empty list with what was just dropped is the same
                                     list, so the button would offer to do nothing. -->
                                <Button Content="Replace list instead"
                                        Visibility="{x:Bind Workbench.CanReplaceWithDrop, Mode=OneWay}"
                                        Command="{x:Bind Workbench.ReplaceWithDropCommand}" />
                                <Button Content="Undo" Command="{x:Bind Workbench.UndoLastActionCommand}" />
                            </StackPanel>
                        </InfoBar.Content>
                    </InfoBar>

                    <!--
                        The metadata half is unavailable. Shown rather than hidden: hiding
                        it would make the app look like it cannot do what it promises, and
                        the user has already asked for something that needs it. One
                        affordance, which opens the consent pane.
                    -->
                    <InfoBar IsOpen="{x:Bind Workbench.NeedsExifTool, Mode=OneWay}"
                             Message="{x:Bind Workbench.EngineDetail, Mode=OneWay}"
                             Title="Photo dates need a free helper"
                             Severity="Warning" IsClosable="False">
                        <InfoBar.ActionButton>
                            <Button Content="Set up ExifTool" Click="OnSetUpExifTool" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <!--
                        The content contradicts the chosen intent. Said once, acted on only
                        if asked: the app knows a folder of documents has no Taken date, and
                        staying quiet would withhold the answer, while changing the choice
                        unasked would overrule a deliberate decision.
                    -->
                    <InfoBar IsOpen="{x:Bind Workbench.HasIntentNudge, Mode=OneWay}"
                             Message="{x:Bind Workbench.IntentNudge, Mode=OneWay}"
                             Severity="Informational" IsClosable="True" CloseButtonClick="OnDismissNudge">
                        <InfoBar.ActionButton>
                            <Button Content="{x:Bind Workbench.NudgeActionLabel, Mode=OneWay}"
                                    Command="{x:Bind Workbench.AcceptNudgeCommand}" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>

                <!--
                    Clear is separated and right-aligned. It was sitting between the sort
                    and the filters, where a destructive action has no business being: the
                    controls beside it only change what you SEE, and it throws the list away.
                -->
                <Grid Grid.Row="2" Margin="0,0,0,8" ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <Button Content="Add folder..." Click="OnAddFolder"
                                Height="{StaticResource CnChromeButtonHeight}" />
                        <ComboBox SelectionChanged="OnSortChanged" MinWidth="180" SelectedIndex="0"
                                  ToolTipService.ToolTip="Sort by biggest change to bring the most-moved dates to the top. It is the quickest way to spot one that looks wrong.">
                            <ComboBoxItem Content="Sort: name" Tag="Name" />
                            <ComboBoxItem Content="Sort: biggest change" Tag="BiggestChange" />
                            <ComboBoxItem Content="Sort: resulting date" Tag="ResultingDate" />
                            <ComboBoxItem Content="Sort: status" Tag="Status" />
                        </ComboBox>
                        <!--
                            Narrows the RUN, not just the view - a folder off a camera holds
                            JPEG, PNG and raw together and wanting to touch one of those is
                            ordinary. The Apply button and the confirmation both say so,
                            because a filter that quietly changes what a destructive button
                            does is how somebody ends up surprised.
                        -->
                        <TextBox Text="{x:Bind Workbench.TypeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="All files" MinWidth="150"
                                 ToolTipService.ToolTip="Limit the run with the same wildcards Explorer uses: *.png, mountain*.jpg, IMG_????.CR2, or several separated by semicolons. Files that do not match are hidden AND left alone." />
                        <!--
                            "Select none" rather than "Clear all" on purpose: there is
                            already a Clear on this bar that REMOVES the files, and two
                            similarly named buttons - one emptying the list, one only
                            unticking it - is exactly the confusion this app keeps trying
                            to avoid.

                            Select all covers what is SHOWN; Select none covers everything
                            loaded. Both err the same way, so neither can leave a file
                            ticked that you never laid eyes on.
                        -->
                        <Button Content="Select all" Command="{x:Bind Workbench.SelectAllShownCommand}"
                                IsEnabled="{x:Bind Workbench.HasAnyFiles, Mode=OneWay}"
                                Height="{StaticResource CnChromeButtonHeight}"
                                ToolTipService.ToolTip="Tick every file currently shown. Anything a filter is hiding is left alone." />
                        <Button Content="Select none" Command="{x:Bind Workbench.SelectNoneCommand}"
                                IsEnabled="{x:Bind Workbench.HasAnyFiles, Mode=OneWay}"
                                Height="{StaticResource CnChromeButtonHeight}"
                                ToolTipService.ToolTip="Untick every file, including any a filter is hiding. Nothing is removed from the list." />

                        <CheckBox Content="Only changing"
                                  IsChecked="{x:Bind Workbench.ShowOnlyChanging, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Hide files that are already correct, so the list shows only what this run would actually alter." />
                        <CheckBox Content="Only problems"
                                  IsChecked="{x:Bind Workbench.ShowOnlyProblems, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Show only files that cannot be changed, or whose result looks wrong and is worth checking before you apply." />
                    </StackPanel>

                    <!--
                        Both disabled when they would do nothing, rather than hidden:
                        a control that appears and vanishes as the list fills and empties
                        is harder to find than one that is simply greyed.
                    -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Content="Clear list" Command="{x:Bind Workbench.ClearListCommand}"
                                IsEnabled="{x:Bind Workbench.HasAnyFiles, Mode=OneWay}"
                                Height="{StaticResource CnChromeButtonHeight}"
                                ToolTipService.ToolTip="Remove every file from the list. Your options are kept, and nothing on disk changes." />
                        <Button Content="Start over" Command="{x:Bind Workbench.StartOverCommand}"
                                IsEnabled="{x:Bind Workbench.CanStartOver, Mode=OneWay}"
                                Height="{StaticResource CnChromeButtonHeight}"
                                ToolTipService.ToolTip="Back to the opening question: no files, no filters, and no choice made yet. Nothing on disk changes." />

                        <!--
                            Always enabled, even with nothing applied yet. A greyed-out
                            History teaches people the app has no undo; an empty one that
                            says so teaches them it does, and that they have not used it.
                        -->
                        <Button Content="History" Click="OnOpenHistory"
                                Height="{StaticResource CnChromeButtonHeight}"
                                ToolTipService.ToolTip="Every run Chronora has applied, and the way back. Undo works days later, not just straight after." />
                    </StackPanel>
                </Grid>

                <!--
                    Uniform two-line rows. The milestone 1 spike settled the rest: no lazy
                    item source and no phased rendering, because 50,000 materialised rows
                    cost 16 ms. The fixed height is NOT optional though - a virtualising
                    layout only estimates extent for non-uniform items, and the scrollbar
                    drifts under the cursor when it has to guess.
                -->
                <ListView x:Name="FileList" Grid.Row="3"
                          ItemsSource="{x:Bind Workbench.Rows, Mode=OneWay}"
                          SelectedItem="{x:Bind Workbench.SelectedRow, Mode=TwoWay}"
                          SelectionMode="Single"
                          ContainerContentChanging="OnRowRealised">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Height" Value="54" />
                            <Setter Property="MinHeight" Value="54" />
                            <Setter Property="Padding" Value="8,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Vertical" CacheLength="2.0" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlanRowViewModel">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto" VerticalAlignment="Center">
                                <CheckBox Grid.RowSpan="2" Grid.Column="0" MinWidth="32"
                                          IsChecked="{x:Bind IsIncluded, Mode=TwoWay}" />

                                <!--
                                    Filled by ContainerContentChanging rather than by a
                                    binding: the icon is set during layout and the real
                                    thumbnail arrives later, which no getter can express.
                                    The row height stays fixed either way, which is what
                                    keeps the scrollbar honest.
                                -->
                                <Border Grid.RowSpan="2" Grid.Column="1" Width="36" Height="36"
                                        Margin="0,0,10,0" CornerRadius="3"
                                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                    <Image x:Name="RowThumbnail" Stretch="Uniform" />
                                </Border>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Bind Name}"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource BodyTextBlockStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="2"
                                           Text="{x:Bind vm:PlanRowViewModel.FormatSummary(Plan, ManualDate), Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" />
                                <TextBlock Grid.RowSpan="2" Grid.Column="3" Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{x:Bind vm:PlanRowViewModel.FormatStatus(Plan), Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!--
                    The empty state, in the same grid cell as the list so it lands in the
                    middle of the large blank area rather than as a line of status text at
                    the top. It says what to do where you would do it, and the whole window
                    already accepts the drop.

                    Not hit-testable, so it cannot swallow the drop it is inviting.
                -->
                <StackPanel Grid.Row="3" Spacing="10"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{x:Bind Workbench.IsListEmpty, Mode=OneWay}">
                    <FontIcon Glyph="&#xE8DE;" FontSize="36" HorizontalAlignment="Center"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Drop files and/or folders here to begin"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <TextBlock Text="or use Add folder…"
                               Style="{StaticResource BodyTextBlockStyle}" Opacity="0.6"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!--
                    Files ARE loaded, the filter is just hiding all of them. A different
                    message from the one above and deliberately so: telling somebody to drop
                    files here when they have already dropped them would be nonsense, and a
                    blank list with no explanation looks like the app lost them.
                -->
                <StackPanel Grid.Row="3" Spacing="10"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{x:Bind Workbench.IsFilteredToNothing, Mode=OneWay}">
                    <FontIcon Glyph="&#xE71C;" FontSize="32" HorizontalAlignment="Center"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <TextBlock Text="{x:Bind Workbench.FilteredToNothingNote, Mode=OneWay}"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center" MaxWidth="420" />
                    <TextBlock Text="Clear the filter box to see them again."
                               Style="{StaticResource BodyTextBlockStyle}" Opacity="0.6"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!--
                    Nothing is hidden: the full field-by-field breakdown is one selection
                    away rather than one navigation away, which is the thing the competing
                    tools get wrong.
                -->
                <!--
                    MinHeight so the pane stops growing and shrinking as you move between a
                    row changing two dates and one changing three, which would otherwise
                    shift the list above under the cursor.
                -->
                <Border Grid.Row="4" Padding="12,8" Margin="0,8,0,8" CornerRadius="4"
                        MinHeight="88"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind Workbench.SelectedRow.Name, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock FontFamily="Consolas" IsTextSelectionEnabled="True"
                                   Text="{x:Bind vm:PlanRowViewModel.FormatDetail(Workbench.SelectedRow.Plan), Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1" Width="1" Margin="4,8"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!--
                The options pane is a fixed width, so every extra pixel of a resized window
                goes to the file list. More screen means more rows, which is what more
                screen is actually for in a bulk tool.
            -->
            <ScrollViewer Grid.Column="2" Padding="16,0,16,0">
                <StackPanel Spacing="8">

                    <!--
                        The only question until it is answered. Everything below is hidden,
                        so the first thing anyone meets is the decision that shapes the rest
                        rather than a wall of controls to guess their way through.
                    -->
                    <TextBlock Text="What are you changing?"
                               Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" TextWrapping="Wrap" />
                    <!--
                        Bound both ways. These were Checked handlers with nothing read
                        back, so a template or a Start over changed the state underneath
                        and left the previous answer still selected - the control
                        contradicting the app.
                    -->
                    <RadioButtons SelectedIndex="{x:Bind Workbench.IntentIndex, Mode=TwoWay}">
                        <x:String>File dates</x:String>
                        <x:String>Photo and video dates</x:String>
                        <x:String>Let me pick the fields</x:String>
                    </RadioButtons>
                    <TextBlock Text="{x:Bind Workbench.IntentNote, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap" />

                    <StackPanel Spacing="8" Visibility="{x:Bind Workbench.HasChosenIntent, Mode=OneWay}">

                    <!--
                        Templates sit above the individual options because for most people
                        they ARE the answer: "photos sort wrong in Explorer" is the whole
                        job, and assembling it from a source dropdown and five checkboxes
                        is work nobody wanted to do.
                    -->
                    <TextBlock Text="Start from a common job (optional)"
                               Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />

                    <ComboBox x:Name="TemplatePicker"
                              ItemsSource="{x:Bind Workbench.Templates, Mode=OneWay}"
                              SelectedItem="{x:Bind Workbench.ActiveTemplate, Mode=OneWay}"
                              SelectionChanged="OnTemplateChosen"
                              PlaceholderText="Choose a template…"
                              HorizontalAlignment="Stretch">
                        <!--
                            Wrapped, and with the description on hover. The options pane
                            is a fixed 320px so a name can outrun it, and a template whose
                            name is cut off is one nobody can choose on purpose.
                        -->
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="domain:DateTemplate">
                                <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap"
                                           ToolTipService.ToolTip="{x:Bind Description}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!--
                        A template can mean more than the controls below can express - an
                        aggregate across several source fields, for one - so its own words
                        are the only place that part of the run is stated. Not decoration.
                    -->
                    <InfoBar IsOpen="{x:Bind Workbench.HasActiveTemplate, Mode=OneWay}"
                             Message="{x:Bind Workbench.ActiveTemplateNote, Mode=OneWay}"
                             Severity="Informational" IsClosable="False" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save as template…" Click="OnSaveTemplate" />
                        <Button Content="Delete" Click="OnDeleteTemplate"
                                IsEnabled="{x:Bind Workbench.CanDeleteActiveTemplate, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock Text="Get the date from" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
                    <RadioButtons SelectedIndex="{x:Bind Workbench.SourceIndex, Mode=TwoWay}">
                        <x:String>A date I pick</x:String>
                        <x:String>Shift the existing date</x:String>
                        <x:String>A date the file already has</x:String>
                        <x:String>The file name</x:String>
                    </RadioButtons>

                    <!--
                        Only the input the chosen source uses. Showing all three at once made
                        the pane taller than the window and invited people to fill in a field
                        that was going to be ignored.
                    -->
                    <StackPanel Spacing="8" Visibility="{x:Bind Workbench.NeedsAbsoluteInput, Mode=OneWay}">
                        <CalendarDatePicker Date="{x:Bind Workbench.AbsoluteDate, Mode=TwoWay}"
                                            Header="Date" PlaceholderText="Pick a date"
                                            HorizontalAlignment="Stretch" />
                        <TimePicker Time="{x:Bind Workbench.AbsoluteTime, Mode=TwoWay}"
                                    Header="Time" HorizontalAlignment="Stretch" ClockIdentifier="24HourClock" />

                        <!--
                            Local, and deliberately with no UTC option beside it. Dates are
                            always entered as the wall-clock reading a person recognises;
                            which frame each format is STORED in is the app's problem and it
                            already decides it per field.
                        -->
                        <Button Content="Use the time now" HorizontalAlignment="Stretch"
                                Command="{x:Bind Workbench.UseNowCommand}"
                                ToolTipService.ToolTip="Fills in the current local date and time. Chronora works out for itself whether each format stores that as local time or UTC." />
                    </StackPanel>

                    <NumberBox Value="{x:Bind Workbench.ShiftHours, Mode=TwoWay}"
                               Visibility="{x:Bind Workbench.NeedsShiftInput, Mode=OneWay}"
                               Header="Shift by (hours)" SpinButtonPlacementMode="Inline"
                               SmallChange="1" LargeChange="6" />

                    <!--
                        This never existed. Choosing "a date the file already has" showed
                        nothing to choose from and quietly fell back to Modified, so the
                        option posed a question and then gave nobody a way to answer it.

                        The list crosses both genres on purpose: reading a photo date to
                        write onto the file dates is the thing this app is for, and the
                        mode only ever limits what may be WRITTEN.
                    -->
                    <ComboBox Visibility="{x:Bind Workbench.NeedsCopyFromInput, Mode=OneWay}"
                              ItemsSource="{x:Bind Workbench.CopyFromOptions}"
                              SelectedIndex="{x:Bind Workbench.CopyFromIndex, Mode=TwoWay}"
                              Header="Which date" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="domain:DateFieldSpec">
                                <TextBlock Text="{x:Bind DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Write it to" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
                    <StackPanel Spacing="2">
                        <!--
                            Each field is offered only where it can actually be written.
                            Ticking a box the recipe then silently drops is worse than not
                            offering it: the preview reports nothing to do and nothing
                            explains why. Editing any of these turns the answer above into
                            "Let me pick the fields", so the label never describes a
                            selection that has moved on.
                        -->
                        <CheckBox Content="Created"
                                  Visibility="{x:Bind Workbench.ShowsFileDates, Mode=OneWay}"
                                  IsChecked="{x:Bind Workbench.WriteCreated, Mode=TwoWay}" />
                        <CheckBox Content="Modified"
                                  Visibility="{x:Bind Workbench.ShowsFileDates, Mode=OneWay}"
                                  IsChecked="{x:Bind Workbench.WriteModified, Mode=TwoWay}" />

                        <!-- Stands alone: for anything that reads the file's own date, it is the only
                             correct choice. -->
                        <CheckBox Content="Taken (photo)"
                                  Visibility="{x:Bind Workbench.IsPhotoMode, Mode=OneWay}"
                                  IsChecked="{x:Bind Workbench.WriteTaken, Mode=TwoWay}"
                                  ToolTipService.ToolTip="The date the photo or video records as when it was taken. Photo libraries read this and ignore the file dates, so on its own it is often exactly right." />

                        <!--
                            Accessed is offered here, not under Advanced. Explorer's
                            Properties dialog shows Created, Modified AND Accessed, so
                            those three are one set in the user's head - and hiding one of
                            them means applying a run leaves a date visibly untouched with
                            nothing on screen explaining why.

                            Off by default, because most people do not want it and the
                            date it holds is rarely meaningful. Offered, not chosen.
                        -->
                        <CheckBox Content="Accessed" Margin="0,6,0,0"
                                  Visibility="{x:Bind Workbench.ShowsFileDates, Mode=OneWay}"
                                  IsChecked="{x:Bind Workbench.WriteAccessed, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Explorer shows this next to Created and Modified. Windows usually stops updating it, so a date set here tends to stay put." />

                        <!--
                            Changed stays under Advanced. Explorer never shows it, so
                            leaving it alone surprises nobody - which is exactly the test
                            Accessed failed.
                        -->
                        <CheckBox Content="Changed (NTFS)"
                                  Visibility="{x:Bind Workbench.ShowsAdvancedFields, Mode=OneWay}"
                                  IsChecked="{x:Bind Workbench.WriteChanged, Mode=TwoWay}"
                                  ToolTipService.ToolTip="A fourth timestamp Explorer never shows. Not every drive can store it." />
                    </StackPanel>

                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Padding="16,8" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                <ProgressRing Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0"
                              IsActive="{x:Bind Workbench.IsApplying, Mode=OneWay}"
                              Visibility="{x:Bind Workbench.IsApplying, Mode=OneWay}" />

                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                           Text="{x:Bind Workbench.ScanStatus, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource CaptionTextBlockStyle}" />

                <Button Grid.Column="2" Content="Cancel" Margin="0,0,8,0"
                        Command="{x:Bind Workbench.CancelRunCommand}"
                        Visibility="{x:Bind Workbench.IsApplying, Mode=OneWay}"
                        Height="{StaticResource CnChromeButtonHeight}" />

                <!-- Undo sits beside Apply rather than in a menu, because the moment someone
                     wants it is the moment straight after the run they regret. -->
                <Button Grid.Column="3" Content="Undo last run" Margin="0,0,8,0"
                        Command="{x:Bind Workbench.UndoLastCommand}"
                        IsEnabled="{x:Bind Workbench.CanUndo, Mode=OneWay}"
                        Height="{StaticResource CnChromeButtonHeight}" />

                <!--
                    This replaced a "Dry run" button. A dry run sitting beside a live
                    preview quietly tells the user the thing they have been looking at might
                    not be real; an export is the same reassurance and is actually useful.
                -->
                <Button Grid.Column="4" Content="Export preview (CSV)" Margin="0,0,8,0"
                        Click="OnExportPreview"
                        Height="{StaticResource CnChromeButtonHeight}" />

                <Button Grid.Column="5" Style="{StaticResource AccentButtonStyle}"
                        Content="{x:Bind Workbench.Summary.ApplyLabel, Mode=OneWay}"
                        Click="OnApply"
                        MinWidth="{StaticResource CnCommandButtonMinWidth}"
                        Height="{StaticResource CnChromeButtonHeight}" />
            </Grid>
        </Border>
    </Grid>
</Window>
