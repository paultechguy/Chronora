<Window
    x:Class="PaulTechGuy.CN.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PaulTechGuy.CN.App.ViewModels">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,*,Auto">

        <Border x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="16,0">
            <TextBlock Text="Chronora &#183; grid spike"
                       VerticalAlignment="Center"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
        </Border>

        <StackPanel Grid.Row="1" Margin="16,0,16,12" Spacing="6">
            <TextBlock Text="{x:Bind Spike.BuildReport, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}" />
            <TextBlock Text="{x:Bind Spike.RecomputeReport, Mode=OneWay}"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Text="{x:Bind Spike.BenchmarkReport, Mode=OneWay}"
                       FontFamily="Consolas"
                       Style="{StaticResource CaptionTextBlockStyle}" />
            <Button Content="Recompute all rows"
                    Command="{x:Bind Spike.RecomputeCommand}"
                    Height="{StaticResource CnChromeButtonHeight}" />
        </StackPanel>

        <!--
            The control under test. ItemsStackPanel virtualises, but only estimates extent for
            non-uniform items, so every row is pinned to one height via ItemContainerStyle.
            That is what keeps the scrollbar honest and the layout out of a re-measure storm.
        -->
        <ListView Grid.Row="2"
                  x:Name="RowList"
                  ItemsSource="{x:Bind Spike.Rows}"
                  SelectionMode="Single"
                  ShowsScrollingPlaceholders="True"
                  IncrementalLoadingTrigger="None">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Height" Value="56" />
                    <Setter Property="MinHeight" Value="56" />
                    <Setter Property="Padding" Value="12,0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Vertical"
                                     CacheLength="2.0" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SpikeRow">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" VerticalAlignment="Center">
                        <CheckBox Grid.RowSpan="2" Grid.Column="0"
                                  IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                  MinWidth="32" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{x:Bind Name}"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{x:Bind vm:SpikeRow.FormatDiff(Before, After), Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Opacity="0.75" />
                        <TextBlock Grid.RowSpan="2" Grid.Column="2"
                                   Text="{x:Bind Status, Mode=OneWay}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border Grid.Row="3" Height="32" Padding="16,0">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Border>
    </Grid>
</Window>
