<Window
    x:Class="PaulTechGuy.CN.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PaulTechGuy.CN.Presentation"
    xmlns:domain="using:PaulTechGuy.CN.Domain"
    xmlns:local="using:PaulTechGuy.CN.App">

    <!--
        The whole window accepts a drop, not just the file list. When the list is empty
        there is no obvious target to aim at, and a drop that lands on the wrong pane and
        does nothing teaches people the feature does not exist.
    -->
    <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,*,Auto"
          AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" DragLeave="OnDragLeave">

        <!--
            ONE flyout, shared by every row, rather than one declared inside the row
            template. A template-level flyout is built for each realised container and
            rebuilt on every recycle, which is a lot of objects for a menu only ever shown
            once at a time. The handler records which row was clicked before showing it.

            Everything here acts on the right-clicked row and nothing else, whatever is
            ticked. A menu item that sometimes means "this file" and sometimes means "these
            three hundred" is how somebody removes three hundred files by accident.
        -->
        <Grid.Resources>
            <MenuFlyout x:Name="RowMenu">
                <MenuFlyoutItem Text="Open" Click="OnRowMenuOpen" />
                <MenuFlyoutItem Text="Show in File Explorer" Click="OnRowMenuShowInExplorer" />
                <MenuFlyoutItem Text="Copy full path" Click="OnRowMenuCopyPath" />
                <MenuFlyoutItem Text="Properties" Click="OnRowMenuProperties" />

                <MenuFlyoutSeparator />

                <MenuFlyoutItem Text="Create a copy" Click="OnRowMenuCreateCopy" />

                <MenuFlyoutSeparator />

                <!-- Text is set when the menu opens, because it names what the click does. -->
                <MenuFlyoutItem Tag="tick" Text="Include in the run" Click="OnRowMenuToggle" />
                <MenuFlyoutItem Text="Run on this file only" Click="OnRowMenuSelectOnly" />
                <MenuFlyoutItem Text="Remove from the list" Click="OnRowMenuRemove" />

                <MenuFlyoutSeparator />

                <MenuFlyoutItem Text="Set this file's date…" Click="OnRowMenuSetDate" />
                <!--
                    Named for what it removes, not for where it lands. It read "Use the
                    run's date again", which is accurate and is not what anybody scans for:
                    reported as "I don't see anything to remove the custom date". The verb
                    people look for is Remove.
                -->
                <MenuFlyoutItem Tag="clear" Text="Remove this file's own date" Click="OnRowMenuClearDate"
                                ToolTipService.ToolTip="This file goes back to the run's date and fields, like every other row." />

                <!-- Text is set when the menu opens, because it carries the count. -->
                <MenuFlyoutItem Tag="clearall" Click="OnRowMenuClearAllDates" />
                <MenuFlyoutItem Text="Use this file's date for the run" Click="OnRowMenuUseDate" />
            </MenuFlyout>
        </Grid.Resources>


        <!--
            The title bar carries exactly one control, and the rule that kept it empty is
            still in force. It used to hold a File dates / Photo dates switch, which was
            redundant with the options pane and could actively contradict it: choosing a
            photo preset set the switch, but moving the switch did not clear the preset.
            One question, asked once, in one place.

            About is allowed here because it says nothing about the run - it cannot
            contradict the options pane, because it makes no claim the options pane could
            disagree with. Anything that describes what a run will do stays out.
        -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="16,0"
              ColumnDefinitions="Auto,*,Auto">

            <!--
                IsHitTestVisible is off on both, and that is not decoration. This Grid is the
                window's drag region, and anything inside it that can be hit-tested is excluded
                from dragging - so a logo and a title that answer the mouse would leave a dead
                strip at the top left where the window cannot be picked up. Neither is
                interactive, so neither needs to be.

                The About button is the same rule read the other way: it IS hit-testable, so
                the framework takes it out of the drag region on its own and it stays
                clickable. SetTitleBar still points at this entire Grid - no
                InputNonClientPointerSource.SetRegionRects needed. Column 1 is empty and
                stretches, so there is always a wide strip left to drag the window by.
            -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                        VerticalAlignment="Center" IsHitTestVisible="False">

                <!--
                    Source is set in code, not bound to ms-appx: - Chronora is unpackaged, so
                    there is no package to resolve that against and a failure draws nothing
                    while logging nothing.
                -->
                <Image x:Name="HeaderLogo" Width="18" Height="18" VerticalAlignment="Center"
                       AutomationProperties.AccessibilityView="Raw" />

                <TextBlock Text="Chronora" VerticalAlignment="Center"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
            </StackPanel>

            <!--
                Spelled out. This was an info glyph and the first person to look for About
                could not find it - which is the whole job of the control, and a tooltip
                only helps somebody already hovering over the thing they could not see.
                Moving it into the title bar is NOT permission to shrink it back to an icon.

                Transparent chrome so it reads as part of the title bar rather than a button
                dropped onto it; the right margin is set in code, because the width of the
                minimize/maximize/close buttons is AppWindow.TitleBar.RightInset, which is
                zero until the window has been laid out and changes with the monitor.
            -->
            <Button x:Name="TitleBarAbout" Grid.Column="2" Content="About" Click="OnOpenAbout"
                    VerticalAlignment="Center" Padding="12,0"
                    Background="Transparent" BorderBrush="Transparent"
                    Height="{StaticResource CnChromeButtonHeight}"
                    ToolTipService.ToolTip="Version, where Chronora keeps your data and logs, the Send to menu, and a check for updates." />
        </Grid>

        <!--
            The command deck: what is loaded, what the run will do, what comes out.

            Full window width, above the split, and not inside the file-list column. At the
            minimum window size that column is about 520 effective pixels once the options
            pane has taken its 320, which is not enough for three segments. Spanning the
            window is what lets the deck exist at a size somebody actually runs the app at.

            Every segment is DERIVED. Nothing here sets anything the options pane also sets,
            because two controls for one question is what the title bar mode switch was
            taken out for. The two counts in RESULT are the exception and they are not a
            second opinion: they drive the same two view filters the toolbar checkboxes do.

            Disabled, not hidden, while a run is in flight.
        -->
        <!--
            The ContentControl is here only to carry IsEnabled, which lives on Control and
            not on Panel - a Grid cannot be disabled. IsTabStop off so it adds a wrapper
            without adding a tab stop.
        -->
        <ContentControl Grid.Row="1" IsTabStop="False"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        IsEnabled="{x:Bind Workbench.DeckEnabled, Mode=OneWay}">
        <Grid Margin="16,0,16,8" ColumnSpacing="8" ColumnDefinitions="Auto,*,Auto">

            <!-- SOURCE -->
            <Border Grid.Column="0" Style="{StaticResource CnDeckCardStyle}">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,2">
                        <FontIcon Glyph="&#xE8B7;" Style="{StaticResource CnDeckCaptionGlyphStyle}" />
                        <TextBlock Text="SOURCE" Style="{StaticResource CnDeckCaptionStyle}" />
                    </StackPanel>

                    <TextBlock Text="{x:Bind Workbench.SourceHeadline, Mode=OneWay}"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <!--
                        How a folder gets read, stated on the card rather than hidden in the
                        flyout - a sticky setting nobody can see is how somebody recursively
                        scans a drive by accident.

                        Worded as the SETTING, not as a description of the list: those are
                        different tenses, and changing the setting does not re-read the
                        disk. "4,000 files / deep" on adjacent lines would go on claiming
                        the list was read deep after you had turned that off.

                        A plain Flyout rather than a MenuFlyout, because a MenuFlyout closes
                        on every invoke - ticking a box would shut the menu and you would
                        reopen it to tick the next one.
                    -->
                    <DropDownButton Style="{StaticResource CnColumnHeaderStyle}"
                                    Content="{x:Bind Workbench.ScanSettingLabel, Mode=OneWay}"
                                    AutomationProperties.Name="How folders are read"
                                    ToolTipService.ToolTip="Applies to drops, Add folder, Send To and the command line alike.">
                        <DropDownButton.Flyout>
                            <Flyout x:Name="ScanOptionsFlyout" Placement="BottomEdgeAlignedLeft">
                                <StackPanel Spacing="8" MinWidth="260">
                                    <TextBlock Text="When Chronora reads a folder"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />

                                    <CheckBox Content="Include subfolders"
                                              IsChecked="{x:Bind Workbench.ScanRecurse, Mode=TwoWay}"
                                              ToolTipService.ToolTip="Read the whole tree beneath the folder, not just the files sitting directly in it." />

                                    <CheckBox Content="Hidden and system files"
                                              IsChecked="{x:Bind Workbench.ScanIncludeHidden, Mode=TwoWay}"
                                              ToolTipService.ToolTip="Off by default. Chronora used to collect these silently, which is not what dropping a folder looks like it means." />

                                    <CheckBox Content="Also set the folders' own dates"
                                              IsChecked="{x:Bind Workbench.ScanIncludeFolders, Mode=TwoWay}"
                                              ToolTipService.ToolTip="Folders carry Created and Modified dates too. Off by default, because a run aimed at photos should not quietly restamp the folders holding them." />

                                    <!--
                                        Changing a setting does not re-read the disk, so
                                        this is how the list is made to match it. Enabled
                                        only when they actually differ - offering it
                                        otherwise would imply something was out of step.
                                    -->
                                    <Button Content="Read the folders again"
                                            HorizontalAlignment="Stretch"
                                            Click="OnRescanWithOptions"
                                            IsEnabled="{x:Bind Workbench.CanRescanWithOptions, Mode=OneWay}"
                                            ToolTipService.ToolTip="Applies these settings to the folders already in the list. Files added one at a time are not re-read." />
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <!--
                        These three are also in the toolbar below for now. The toolbar goes
                        in the next commit; duplicating them for one commit keeps every
                        action reachable at every point in the series, which deleting the
                        toolbar first would not.
                    -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                Spacing="{StaticResource CnButtonGroupSpacing}">
                        <Button Content="Add folder…" Click="OnAddFolder"
                                Height="{StaticResource CnFormRowHeight}"
                                ToolTipService.ToolTip="Read a folder into the list. Dropping files or folders onto the window does the same thing." />

                        <Button Content="Clear list" Command="{x:Bind Workbench.ClearListCommand}"
                                IsEnabled="{x:Bind Workbench.HasAnyFiles, Mode=OneWay}"
                                Height="{StaticResource CnFormRowHeight}"
                                ToolTipService.ToolTip="Remove every file from the list. Your options are kept, and nothing on disk changes." />

                        <Button Content="Start over" Command="{x:Bind Workbench.StartOverCommand}"
                                IsEnabled="{x:Bind Workbench.CanStartOver, Mode=OneWay}"
                                Height="{StaticResource CnFormRowHeight}"
                                ToolTipService.ToolTip="Back to the opening question: no files, no filters, and no choice made yet. Nothing on disk changes." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- RULE -->
            <Border Grid.Column="1" Style="{StaticResource CnDeckCardStyle}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,2">
                            <FontIcon Glyph="&#xE9D5;" Style="{StaticResource CnDeckCaptionGlyphStyle}" />
                            <TextBlock Text="RULE" Style="{StaticResource CnDeckCaptionStyle}" />
                        </StackPanel>

                        <!--
                            A template can carry a rule the pane cannot show - the built-in
                            "Make every date consistent" reads the earliest of three fields
                            while the pane displays only the first. So when a template is in
                            charge this quotes the template instead of paraphrasing controls
                            that would state it wrongly, in the most prominent place in the
                            window, against the template's own description.
                        -->
                        <StackPanel Spacing="2" Visibility="{x:Bind Workbench.IsRuleFromTemplate, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Workbench.RuleTemplateName, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Workbench.ActiveTemplateNote, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75"
                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!--
                            The ordinary case: the pane's own answers, restated. Separate
                            panel rather than a converter, because this app has never needed
                            one and a negated bool on the view model is easier to read than
                            a converter instance nobody can grep for.
                        -->
                        <StackPanel Spacing="2" Visibility="{x:Bind Workbench.IsRuleFromPane, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Workbench.RuleIntentLine, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" />

                            <TextBlock Text="{x:Bind Workbench.RuleSourceLine, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75"
                                       TextTrimming="CharacterEllipsis" />

                            <TextBlock Text="{x:Bind Workbench.RuleTargetLine, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <!--
                        A link with a verb and a destination, rather than making the whole
                        card clickable. A card that silently moved focus into a pane that
                        cannot scroll to the thing you wanted would be a dead click dressed
                        as a control - and the card beside it really does toggle a filter,
                        so three segments that look alike must not behave three ways.
                    -->
                    <HyperlinkButton Grid.Column="1" Content="Edit →" VerticalAlignment="Top"
                                     Padding="6,0" Click="OnEditRule"
                                     ToolTipService.ToolTip="The options pane on the right is where the run is built." />
                </Grid>
            </Border>

            <!-- RESULT -->
            <Border Grid.Column="2" Style="{StaticResource CnDeckCardStyle}" MinWidth="200">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,2">
                        <FontIcon Glyph="&#xE9D9;" Style="{StaticResource CnDeckCaptionGlyphStyle}" />
                        <TextBlock Text="RESULT" Style="{StaticResource CnDeckCaptionStyle}" />
                    </StackPanel>

                    <!--
                        The number Apply acts on, not the number of files that COULD change.
                        Those differ the moment somebody unticks a row, and the old summary
                        headline reported the second one - so unticking eighty rows left the
                        top of the window saying 96 while the button said 12.
                    -->
                    <TextBlock Text="{x:Bind Workbench.ResultHeadline, Mode=OneWay}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />

                    <!--
                        The counts ARE the filters. Both stay independent - either, neither
                        or both - exactly as the two checkboxes below them are.

                        "need a look" is counted from FilesWithProblems, the union. Blocked
                        and suspicious are separate tallies that double-count a file which
                        is both, so labelling this from either of them would promise four
                        rows and produce nine.
                    -->
                    <ToggleButton Style="{StaticResource CnDeckFilterToggleStyle}" Margin="0,2,0,0"
                                  IsChecked="{x:Bind Workbench.ShowOnlyChanging, Mode=TwoWay}"
                                  IsEnabled="{x:Bind Workbench.CanFilterChanging, Mode=OneWay}"
                                  AutomationProperties.Name="Show only the files that will change"
                                  ToolTipService.ToolTip="Show only the files this run will actually change.">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{x:Bind Workbench.ChangingFilterLabel, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <FontIcon Grid.Column="1" Glyph="&#xE71C;" FontSize="10" Margin="8,0,0,0" />
                        </Grid>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource CnDeckFilterToggleStyle}"
                                  IsChecked="{x:Bind Workbench.ShowOnlyProblems, Mode=TwoWay}"
                                  IsEnabled="{x:Bind Workbench.CanFilterProblems, Mode=OneWay}"
                                  AutomationProperties.Name="Show only the files that need a look"
                                  ToolTipService.ToolTip="Show only files that cannot be changed, or whose result looks wrong and is worth checking before you apply.">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{x:Bind Workbench.ProblemsFilterLabel, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <FontIcon Grid.Column="1" Glyph="&#xE71C;" FontSize="10" Margin="8,0,0,0" />
                        </Grid>
                    </ToggleButton>
                </StackPanel>
            </Border>
        </Grid>
        </ContentControl>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,320">

            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16,0,8,0">

                <!--
                    The summary band IS the preview. Six lines someone can actually verify
                    beats 4,000 rows they cannot, and it is what makes a batch of 63 videos
                    landing on 1904 visible without scrolling to find them.
                -->
                <!--
                    Hidden entirely until there is something to summarise. An empty card
                    reading "0 of 0 will change" is worse than no card: it occupies the most
                    prominent place on screen to say nothing, right when the pane should be
                    inviting the first drop instead.
                -->
                <Border Grid.Row="0" Padding="12,8" CornerRadius="4" Margin="0,0,0,8"
                        Visibility="{x:Bind Workbench.HasAnyFiles, Mode=OneWay}"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <StackPanel Spacing="2">
                        <ItemsControl ItemsSource="{x:Bind Workbench.Summary.Lines, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SummaryLine">
                                    <Grid ColumnDefinitions="110,*,Auto">
                                        <!--
                                            The field name in the accent, because it is the
                                            column the eye scans down when checking a run -
                                            and because a window this grey needs the
                                            structure of its most-read block to be visible
                                            without reading it.
                                        -->
                                        <TextBlock Grid.Column="0" Text="{x:Bind FieldName}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Detail}"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind SuspiciousDetail}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!--
                            Fields that were asked for and will NOT happen, shown as
                            prominently as the ones that will. Omitting them was the exact
                            failure the destination presets exist to prevent: tick a field,
                            see a clean summary, and learn nothing about why it did nothing.
                        -->
                        <ItemsControl ItemsSource="{x:Bind Workbench.Summary.BlockedLines, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BlockedLine">
                                    <Grid ColumnDefinitions="110,*">
                                        <TextBlock Grid.Column="0" Text="{x:Bind FieldName}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Detail}"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{x:Bind Workbench.Summary.StatusLine, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Spacing="6">

                    <!--
                        The metadata half is unavailable. Shown rather than hidden: hiding
                        it would make the app look like it cannot do what it promises, and
                        the user has already asked for something that needs it. One
                        affordance, which opens the consent pane.
                    -->
                    <InfoBar IsOpen="{x:Bind Workbench.NeedsExifTool, Mode=OneWay}"
                             Message="{x:Bind Workbench.EngineDetail, Mode=OneWay}"
                             Title="Photo dates need a free helper"
                             Severity="Warning" IsClosable="False">
                        <InfoBar.ActionButton>
                            <Button Content="Set up ExifTool" Click="OnSetUpExifTool" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <!--
                        The content contradicts the chosen intent. Said once, acted on only
                        if asked: the app knows a folder of documents has no Taken date, and
                        staying quiet would withhold the answer, while changing the choice
                        unasked would overrule a deliberate decision.
                    -->
                    <InfoBar IsOpen="{x:Bind Workbench.HasIntentNudge, Mode=OneWay}"
                             Message="{x:Bind Workbench.IntentNudge, Mode=OneWay}"
                             Severity="Informational" IsClosable="True" CloseButtonClick="OnDismissNudge">
                        <InfoBar.ActionButton>
                            <Button Content="{x:Bind Workbench.NudgeActionLabel, Mode=OneWay}"
                                    Command="{x:Bind Workbench.AcceptNudgeCommand}" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>

                <!--
                    The list header: the controls that belong to the list, attached to it.

                    This replaces a single toolbar row that held eleven controls covering
                    six unrelated kinds of action, and was the widest thing in the window -
                    it is what kept the minimum width where it was and why the file pane had
                    to be so wide. Sorting, filtering and selecting are not commands; they
                    are view controls for the pane directly underneath them, and they were
                    in a toolbar only because there was a toolbar.

                    Add folder, Clear list and Start over went to the deck's SOURCE segment.
                    History and About left in the previous commit. Export preview (CSV) came
                    the other way, out of the footer and into the overflow here, because it
                    exports the preview of THIS list.
                -->
                <Grid Grid.Row="2" Margin="0,0,0,4" RowDefinitions="Auto,Auto">

                    <Grid Grid.Row="0" Margin="8,0,8,6" ColumnSpacing="8"
                          ColumnDefinitions="Auto,Auto,*,Auto,Auto">

                        <!--
                            A funnel, not a magnifier. A magnifier in a list header means
                            "narrow what I see" to everybody who has ever used a computer,
                            and this control narrows what gets WRITTEN.
                        -->
                        <FontIcon Grid.Column="0" Glyph="&#xE71C;" FontSize="12" Opacity="0.6"
                                  VerticalAlignment="Center" />

                        <TextBox Grid.Column="1" MinWidth="140"
                                 Text="{x:Bind Workbench.TypeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="All files"
                                 AutomationProperties.Name="Limit the run to these file types"
                                 ToolTipService.ToolTip="Limit the run with the same wildcards Explorer uses: *.png, mountain*.jpg, IMG_????.CR2, or several separated by semicolons. Files that do not match are hidden AND left alone." />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center">

                            <!--
                                Said here as well as on the Apply button. The button is the
                                last line of defence; this is the place it was typed, and a
                                filter that scopes a destructive action should say what it
                                is costing where it was set.
                            -->
                            <Border Style="{StaticResource CnChipStyle}"
                                    Visibility="{x:Bind Workbench.HasTypeFilter, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <TextBlock Text="{x:Bind Workbench.TypeFilterChipLabel, Mode=OneWay}"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                    <Button Style="{StaticResource CnChipCloseStyle}" Content="&#xE711;"
                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                            Command="{x:Bind Workbench.ClearTypeFilterCommand}"
                                            AutomationProperties.Name="Clear the type filter"
                                            ToolTipService.ToolTip="Put every file back in the run." />
                                </StackPanel>
                            </Border>

                            <!--
                                Two of the four sorts have no column of their own, so when
                                one of them is in force it is stated here instead. The
                                alternative - parking the caret on the nearest header, or
                                renaming that header to match - would leave a header
                                describing something other than the column beneath it.
                            -->
                            <Border Style="{StaticResource CnChipStyle}"
                                    Visibility="{x:Bind Workbench.IsSortOffColumn, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <TextBlock Text="{x:Bind Workbench.SortChipLabel, Mode=OneWay}"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                    <Button Style="{StaticResource CnChipCloseStyle}" Content="&#xE711;"
                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                            Command="{x:Bind Workbench.SortByNameCommand}"
                                            AutomationProperties.Name="Sort by name again"
                                            ToolTipService.ToolTip="Back to sorting by file name." />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!--
                            Two verbs, never one tri-state checkbox, and each carries its
                            own scope as a number.

                            Select all covers what is SHOWN; Select none covers everything
                            loaded, including whatever a filter is hiding. Both err the same
                            way, so neither can leave a file ticked that nobody laid eyes
                            on - but a checkbox in a list header means the rows below it to
                            everyone alive, so unticking one with a filter on would silently
                            clear hundreds of files that are not on screen. The counts in
                            the labels are what make the difference visible before the click
                            rather than after it.
                        -->
                        <DropDownButton Grid.Column="3" Content="Select"
                                        Height="{StaticResource CnFormRowHeight}"
                                        IsEnabled="{x:Bind Workbench.HasAnyFiles, Mode=OneWay}">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Text="{x:Bind Workbench.SelectAllLabel, Mode=OneWay}"
                                                    Command="{x:Bind Workbench.SelectAllShownCommand}"
                                                    ToolTipService.ToolTip="Tick every file currently shown. Anything a filter is hiding is left alone.">
                                        <MenuFlyoutItem.KeyboardAccelerators>
                                            <KeyboardAccelerator Modifiers="Control" Key="A" />
                                        </MenuFlyoutItem.KeyboardAccelerators>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="{x:Bind Workbench.SelectNoneLabel, Mode=OneWay}"
                                                    Command="{x:Bind Workbench.SelectNoneCommand}"
                                                    ToolTipService.ToolTip="Untick every file, including any a filter is hiding. Nothing is removed from the list.">
                                        <MenuFlyoutItem.KeyboardAccelerators>
                                            <KeyboardAccelerator Modifiers="Control,Shift" Key="A" />
                                        </MenuFlyoutItem.KeyboardAccelerators>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>

                        <Button Grid.Column="4" Content="&#xE712;"
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                Height="{StaticResource CnFormRowHeight}"
                                AutomationProperties.Name="More list actions"
                                ToolTipService.ToolTip="Export the preview, and the way back from a filter that is hiding everything.">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <!--
                                        The two sorts with no column of their own. They used
                                        to hang off the File header, which meant that header
                                        carried a sort caret AND a dropdown chevron - two
                                        arrows side by side on one small label, each meaning
                                        something different. A column header's job is to
                                        sort its own column on a click; an unusual order is
                                        a list action and belongs with the other ones.
                                    -->
                                    <MenuFlyoutItem Text="Sort by biggest change" Click="OnSortByBiggestChange"
                                                    ToolTipService.ToolTip="Brings the most-moved dates to the top. It is the quickest way to spot one that looks wrong." />
                                    <MenuFlyoutItem Text="Sort by resulting date" Click="OnSortByResultingDate" />
                                    <MenuFlyoutItem Text="Reverse the order"
                                                    Command="{x:Bind Workbench.ReverseSortCommand}"
                                                    ToolTipService.ToolTip="The File and Status headers reverse on a second click; these two have no header to click." />

                                    <MenuFlyoutSeparator />

                                    <MenuFlyoutItem Text="Show all files"
                                                    Command="{x:Bind Workbench.ShowAllFilesCommand}"
                                                    IsEnabled="{x:Bind Workbench.IsAnyFilterOn, Mode=OneWay}"
                                                    ToolTipService.ToolTip="Clears the type filter and both view filters, whichever of them is narrowing the list." />
                                    <MenuFlyoutItem Text="Export preview (CSV)…" Click="OnExportPreview" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <!--
                        The column labels.

                        THREE labels, because there are three columns. The file name and
                        what-changes share one column, stacked - the row is two lines - so
                        there is no "what changes" column to put a header over, and drawing
                        one would be a header describing a column that does not exist.

                        Both labels are plain buttons: click to sort, click again to
                        reverse. Nothing hangs a menu off them. The File label briefly did,
                        and carried a sort caret and a dropdown chevron at the same time -
                        two arrows on one small label, each meaning something different. The
                        orders with no column live under the ⋯ button with the other list
                        actions, and announce themselves in a chip when one is in force.

                        The widths here are literal numbers and they are duplicated in the
                        row DataTemplate below. They cannot be shared: ColumnDefinition.Width
                        is a GridLength, XAML will not run a type converter on the result of
                        a markup extension, and a GridLength cannot be declared as a resource
                        in the first place. SharedSizeGroup is WPF only. So: 32 / 46 / * /
                        120 here, and the same four in the template - change one, change the
                        other.
                    -->
                    <Border Grid.Row="1" Margin="8,0,8,0" Padding="0,0,0,4"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid ColumnDefinitions="32,46,*,120">

                            <!--
                                The caret is the sort state and the label is the column. The
                                label never changes to name a different quantity: a header
                                that renames itself is a header that lies about what is
                                under it.
                            -->
                            <Button Grid.Column="2" Style="{StaticResource CnColumnHeaderStyle}"
                                    Click="OnSortByName"
                                    AutomationProperties.Name="File, and how the list is sorted"
                                    ToolTipService.ToolTip="Sort by file name. Click again to reverse it. The other two orders are under the ⋯ button.">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="File" />
                                    <TextBlock Text="{x:Bind Workbench.FileHeaderCaret, Mode=OneWay}"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Button>

                            <!--
                                12 to the left, matching the row template's status margin,
                                so the label sits over the text it names rather than 12px
                                to the left of all of it.
                            -->
                            <Button Grid.Column="3" Margin="12,0,0,0"
                                    Style="{StaticResource CnColumnHeaderStyle}"
                                    Click="OnSortByStatus"
                                    AutomationProperties.Name="Status, and how the list is sorted"
                                    ToolTipService.ToolTip="Sort by status to bring anything blocked or questionable to the top.">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="Status" />
                                    <TextBlock Text="{x:Bind Workbench.StatusHeaderCaret, Mode=OneWay}"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>


                <!--
                    Uniform two-line rows. The milestone 1 spike settled the rest: no lazy
                    item source and no phased rendering, because 50,000 materialised rows
                    cost 16 ms. The fixed height is NOT optional though - a virtualising
                    layout only estimates extent for non-uniform items, and the scrollbar
                    drifts under the cursor when it has to guess.
                -->
                <ListView x:Name="FileList" Grid.Row="3" Padding="0"
                          ItemsSource="{x:Bind Workbench.Rows, Mode=OneWay}"
                          SelectedItem="{x:Bind Workbench.SelectedRow, Mode=TwoWay}"
                          SelectionMode="Single"
                          ContainerContentChanging="OnRowRealised">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Height" Value="54" />
                            <Setter Property="MinHeight" Value="54" />
                            <Setter Property="Padding" Value="8,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Vertical" CacheLength="2.0" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PlanRowViewModel">
                            <!--
                                32 / 46 / * / 120, and the same four numbers are in the
                                column-header Grid above the list. They are literals in both
                                places because they cannot be shared: ColumnDefinition.Width
                                is a GridLength, XAML does not run type converters on the
                                result of a markup extension, and a GridLength cannot be
                                declared as a resource at all. SharedSizeGroup is WPF only.
                                Change one, change the other.
                            -->
                            <Grid ColumnDefinitions="32,46,*,120" RowDefinitions="Auto,Auto" VerticalAlignment="Center">
                                <CheckBox Grid.RowSpan="2" Grid.Column="0" MinWidth="32"
                                          IsChecked="{x:Bind IsIncluded, Mode=TwoWay}" />

                                <!--
                                    Filled by ContainerContentChanging rather than by a
                                    binding: the icon is set during layout and the real
                                    thumbnail arrives later, which no getter can express.
                                    The row height stays fixed either way, which is what
                                    keeps the scrollbar honest.
                                -->
                                <Border Grid.RowSpan="2" Grid.Column="1" Width="36" Height="36"
                                        Margin="0,0,10,0" CornerRadius="3"
                                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                    <Image x:Name="RowThumbnail" Stretch="Uniform" />
                                </Border>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Bind Name}"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource BodyTextBlockStyle}" />
                                <TextBlock Grid.Row="1" Grid.Column="2"
                                           Text="{x:Bind vm:PlanRowViewModel.FormatSummary(Plan, ManualDate), Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"
                                           Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" />
                                <TextBlock Grid.RowSpan="2" Grid.Column="3" Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{x:Bind vm:PlanRowViewModel.FormatStatus(Plan), Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!--
                    The empty state, in the same grid cell as the list so it lands in the
                    middle of the large blank area rather than as a line of status text at
                    the top. It says what to do where you would do it, and the whole window
                    already accepts the drop.

                    Not hit-testable, so it cannot swallow the drop it is inviting.
                -->
                <StackPanel Grid.Row="3" Spacing="10"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{x:Bind Workbench.IsListEmpty, Mode=OneWay}">
                    <FontIcon Glyph="&#xE8DE;" FontSize="36" HorizontalAlignment="Center"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="Drop files and/or folders here to begin"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <TextBlock Text="or use Add folder…"
                               Style="{StaticResource BodyTextBlockStyle}" Opacity="0.6"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!--
                    Files ARE loaded, the filter is just hiding all of them. A different
                    message from the one above and deliberately so: telling somebody to drop
                    files here when they have already dropped them would be nonsense, and a
                    blank list with no explanation looks like the app lost them.
                -->
                <!--
                    Hit-testable, unlike the empty state above it, because it now carries a
                    button and IsHitTestVisible="False" on a parent cannot be opted out of
                    by a child. That is safe here in a way it would not be for the drop
                    invitation: DragOver and Drop are routed events, so they still reach
                    RootGrid, and nothing in this panel sets AllowDrop to claim them.
                -->
                <StackPanel Grid.Row="3" Spacing="10"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{x:Bind Workbench.IsFilteredToNothing, Mode=OneWay}">
                    <FontIcon Glyph="&#xE71C;" FontSize="32" HorizontalAlignment="Center"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <TextBlock Text="{x:Bind Workbench.FilteredToNothingNote, Mode=OneWay}"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center" MaxWidth="420" />
                    <!--
                        A button, not an instruction. The instruction used to read "Clear
                        the filter box to see them again", which is only right when the type
                        filter is the cause - and the commonest cause is not. Apply rescans
                        on success, so finishing a run with "only files that will change" on
                        empties the list, and the app pointed at an empty box while looking
                        like it had lost every file it had just written correctly.

                        One button rather than three, because somebody looking at an empty
                        list does not know which filter emptied it. That IS the problem.
                    -->
                    <Button Content="Show all files" HorizontalAlignment="Center"
                            Command="{x:Bind Workbench.ShowAllFilesCommand}"
                            Height="{StaticResource CnChromeButtonHeight}"
                            ToolTipService.ToolTip="Clears the type filter and both view filters, whichever of them is hiding the list." />
                </StackPanel>

                <!--
                    What the last action did, and the way back from it.

                    This was a fourth InfoBar in the stack above the list, which meant
                    clearing a list moved the entire window down by forty pixels to tell you
                    so, and left the bar there until it was dismissed. A banner that reflows
                    the window reads as though something went wrong; this is a thing that
                    went RIGHT and is merely reversible.

                    So: floating, over the bottom of the list, out of the layout entirely,
                    and it takes itself away after a few seconds. The two InfoBars left
                    upstairs describe conditions that are still true and stay put, which is
                    what that shape is for.

                    Hovering holds it open - reaching for Undo and having it vanish under
                    the pointer would be worse than never offering it.
                -->
                <Border x:Name="ActionToast" Grid.Row="3"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="16" Padding="14,8" CornerRadius="8" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        PointerEntered="OnToastPointerEntered" PointerExited="OnToastPointerExited"
                        Visibility="{x:Bind Workbench.HasActionNotice, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="14" VerticalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  AutomationProperties.AccessibilityView="Raw" />

                        <TextBlock Text="{x:Bind Workbench.ActionNotice, Mode=OneWay}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />

                        <!--
                            Only when the drop landed on top of something. Replacing an empty
                            list with what was just dropped is the same list, so the button
                            would offer to do nothing.
                        -->
                        <Button Content="Replace list instead"
                                Visibility="{x:Bind Workbench.CanReplaceWithDrop, Mode=OneWay}"
                                Command="{x:Bind Workbench.ReplaceWithDropCommand}"
                                Height="{StaticResource CnFormRowHeight}" />

                        <Button Content="Undo" Command="{x:Bind Workbench.UndoLastActionCommand}"
                                Height="{StaticResource CnFormRowHeight}" />

                        <Button Content="&#xE711;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                Style="{StaticResource CnChipCloseStyle}"
                                Click="OnDismissActionNotice"
                                AutomationProperties.Name="Dismiss"
                                VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!--
                    Nothing is hidden: the full field-by-field breakdown is one selection
                    away rather than one navigation away, which is the thing the competing
                    tools get wrong.
                -->
                <!--
                    MinHeight so the pane stops growing and shrinking as you move between a
                    row changing two dates and one changing three, which would otherwise
                    shift the list above under the cursor.
                -->
                <Border Grid.Row="4" Padding="12,8" Margin="0,8,0,8" CornerRadius="4"
                        MinHeight="88"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind Workbench.SelectedRow.Name, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock FontFamily="Consolas" IsTextSelectionEnabled="True"
                                   Text="{x:Bind vm:PlanRowViewModel.FormatDetail(Workbench.SelectedRow.Plan), Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}" />

                        <!--
                            Shown only for a row that is getting a Taken date Windows will
                            not display. The detail pane is the other place somebody checks
                            one file, so the caveat belongs here as well as in the
                            confirmation - the alternative is they read "Taken → 14:30"
                            here, look in Explorer, see nothing, and file a bug.
                        -->
                        <TextBlock TextWrapping="Wrap" Opacity="0.75"
                                   Visibility="{x:Bind Workbench.SelectedRow.ShowsTakenNote, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Text="Windows does not show Date taken for PNG. Chronora still writes it, and photo apps will read it." />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="1" Width="1" Margin="4,8"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!--
                The options pane is a fixed width, so every extra pixel of a resized window
                goes to the file list. More screen means more rows, which is what more
                screen is actually for in a bulk tool.
            -->
            <ScrollViewer Grid.Column="2" Padding="16,0,16,0">
                <StackPanel Spacing="8">

                    <!--
                        The only question until it is answered. Everything below is hidden,
                        so the first thing anyone meets is the decision that shapes the rest
                        rather than a wall of controls to guess their way through.
                    -->
                    <TextBlock Text="What are you changing?"
                               Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" TextWrapping="Wrap" />
                    <!--
                        Bound both ways. These were Checked handlers with nothing read
                        back, so a template or a Start over changed the state underneath
                        and left the previous answer still selected - the control
                        contradicting the app.
                    -->
                    <RadioButtons x:Name="IntentChoice" SelectedIndex="{x:Bind Workbench.IntentIndex, Mode=TwoWay}">
                        <x:String>File dates</x:String>
                        <x:String>Photo and video dates</x:String>
                        <x:String>Let me pick the fields</x:String>
                    </RadioButtons>
                    <TextBlock Text="{x:Bind Workbench.IntentNote, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap" />

                    <StackPanel Spacing="8" Visibility="{x:Bind Workbench.HasChosenIntent, Mode=OneWay}">

                    <!--
                        Templates sit above the individual options because for most people
                        they ARE the answer: "photos sort wrong in Explorer" is the whole
                        job, and assembling it from a source dropdown and five checkboxes
                        is work nobody wanted to do.
                    -->
                    <TextBlock Text="Start from a common job (optional)"
                               Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />

                    <ComboBox x:Name="TemplatePicker"
                              ItemsSource="{x:Bind Workbench.Templates, Mode=OneWay}"
                              SelectedItem="{x:Bind Workbench.ActiveTemplate, Mode=OneWay}"
                              SelectionChanged="OnTemplateChosen"
                              PlaceholderText="Choose a template…"
                              HorizontalAlignment="Stretch">
                        <!--
                            Wrapped, and with the description on hover. The options pane
                            is a fixed 320px so a name can outrun it, and a template whose
                            name is cut off is one nobody can choose on purpose.
                        -->
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="domain:DateTemplate">
                                <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap"
                                           ToolTipService.ToolTip="{x:Bind Description}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!--
                        A template can mean more than the controls below can express - an
                        aggregate across several source fields, for one - so its own words
                        are the only place that part of the run is stated. Not decoration.
                    -->
                    <InfoBar IsOpen="{x:Bind Workbench.HasActiveTemplate, Mode=OneWay}"
                             Message="{x:Bind Workbench.ActiveTemplateNote, Mode=OneWay}"
                             Severity="Informational" IsClosable="False" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save as template…" Click="OnSaveTemplate" />
                        <Button Content="Delete" Click="OnDeleteTemplate"
                                IsEnabled="{x:Bind Workbench.CanDeleteActiveTemplate, Mode=OneWay}" />

                        <!--
                            A template is one small file on purpose, so the answer to "what
                            settings did you use?" in a forum thread can be the file itself
                            rather than a screenshot of this pane. Behind a menu because
                            these are the rarest two actions here, and a row of four buttons
                            would give them the same weight as saving one.
                        -->
                        <Button Content="&#xE712;" FontFamily="{StaticResource SymbolThemeFontFamily}"
                                ToolTipService.ToolTip="Share a template">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Export this template…" Click="OnExportTemplate"
                                                    IsEnabled="{x:Bind Workbench.HasActiveTemplate, Mode=OneWay}" />
                                    <MenuFlyoutItem Text="Import a template…" Click="OnImportTemplate" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="Get the date from" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
                    <RadioButtons SelectedIndex="{x:Bind Workbench.SourceIndex, Mode=TwoWay}">
                        <x:String>A date I pick</x:String>
                        <x:String>Shift the existing date</x:String>
                        <x:String>A date the file already has</x:String>
                        <x:String>The file name</x:String>
                    </RadioButtons>

                    <!--
                        Only the input the chosen source uses. Showing all three at once made
                        the pane taller than the window and invited people to fill in a field
                        that was going to be ignored.
                    -->
                    <StackPanel Spacing="8" Visibility="{x:Bind Workbench.NeedsAbsoluteInput, Mode=OneWay}">
                        <CalendarDatePicker Date="{x:Bind Workbench.AbsoluteDate, Mode=TwoWay}"
                                            Header="Date" PlaceholderText="Pick a date"
                                            HorizontalAlignment="Stretch" />
                        <TimePicker Time="{x:Bind Workbench.AbsoluteTime, Mode=TwoWay}"
                                    Header="Time" HorizontalAlignment="Stretch" ClockIdentifier="24HourClock" />

                        <!--
                            Local, and deliberately with no UTC option beside it. Dates are
                            always entered as the wall-clock reading a person recognises;
                            which frame each format is STORED in is the app's problem and it
                            already decides it per field.
                        -->
                        <Button Content="Use the time now" HorizontalAlignment="Stretch"
                                Command="{x:Bind Workbench.UseNowCommand}"
                                ToolTipService.ToolTip="Fills in the current local date and time. Chronora works out for itself whether each format stores that as local time or UTC." />
                    </StackPanel>

                    <NumberBox Value="{x:Bind Workbench.ShiftHours, Mode=TwoWay}"
                               Visibility="{x:Bind Workbench.NeedsShiftInput, Mode=OneWay}"
                               Header="Shift by (hours)" SpinButtonPlacementMode="Inline"
                               SmallChange="1" LargeChange="6" />

                    <!--
                        This never existed. Choosing "a date the file already has" showed
                        nothing to choose from and quietly fell back to Modified, so the
                        option posed a question and then gave nobody a way to answer it.

                        The list crosses both genres on purpose: reading a photo date to
                        write onto the file dates is the thing this app is for, and the
                        mode only ever limits what may be WRITTEN.
                    -->
                    <ComboBox Visibility="{x:Bind Workbench.NeedsCopyFromInput, Mode=OneWay}"
                              ItemsSource="{x:Bind Workbench.CopyFromOptions}"
                              SelectedIndex="{x:Bind Workbench.CopyFromIndex, Mode=TwoWay}"
                              Header="Which date" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="domain:DateFieldSpec">
                                <TextBlock Text="{x:Bind DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!--
                        Chronora tries its own list of known filename shapes first, and for
                        most people that is the end of it. This is the escape hatch for the
                        camera nobody has heard of - and it is a chip builder rather than a
                        regex box because the person who needs an escape hatch is the one
                        the built-ins just failed.
                    -->
                    <StackPanel Spacing="8" Visibility="{x:Bind Workbench.NeedsFilenameInput, Mode=OneWay}">
                        <TextBlock TextWrapping="Wrap" Opacity="0.75"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Text="Chronora recognises most camera and phone file names on its own. If yours is not one of them, show it which numbers are the date." />

                        <Button Content="Teach it this file name…" HorizontalAlignment="Stretch"
                                Click="OnBuildFilenamePattern"
                                IsEnabled="{x:Bind Workbench.HasAnyFiles, Mode=OneWay}" />

                        <StackPanel Spacing="4" Visibility="{x:Bind Workbench.HasCustomPattern, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Workbench.CustomPatternTokens, Mode=OneWay}"
                                       FontFamily="Consolas" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <HyperlinkButton Content="Use the built-in patterns instead"
                                             Click="OnForgetFilenamePattern" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Write it to" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
                    <StackPanel Spacing="2">
                        <!--
                            Each field is offered only where it can actually be written.
                            Ticking a box the recipe then silently drops is worse than not
                            offering it: the preview reports nothing to do and nothing
                            explains why. Editing any of these turns the answer above into
                            "Let me pick the fields", so the label never describes a
                            selection that has moved on.
                        -->
                        <CheckBox Content="Created"
                                  Visibility="{x:Bind Workbench.ShowsFileDates, Mode=OneWay}"
                                  IsChecked="{x:Bind Workbench.WriteCreated, Mode=TwoWay}" />
                        <CheckBox Content="Modified"
                                  Visibility="{x:Bind Workbench.ShowsFileDates, Mode=OneWay}"
                                  IsChecked="{x:Bind Workbench.WriteModified, Mode=TwoWay}" />

                        <!-- Stands alone: for anything that reads the file's own date, it is the only
                             correct choice. -->
                        <CheckBox Content="Taken (photo)"
                                  Visibility="{x:Bind Workbench.IsPhotoMode, Mode=OneWay}"
                                  IsChecked="{x:Bind Workbench.WriteTaken, Mode=TwoWay}"
                                  ToolTipService.ToolTip="The date the photo or video records as when it was taken. Photo libraries read this and ignore the file dates, so on its own it is often exactly right." />

                        <!--
                            Accessed used to be offered here, on the reasoning that
                            Explorer's Properties dialog shows Created, Modified AND
                            Accessed, so the three are one set in the user's head.

                            It is gone, because the tooltip that sat here was wrong. It
                            claimed "Windows usually stops updating it, so a date set here
                            tends to stay put". The Windows default is "System Managed",
                            which means last-access updates are ON, and then merely reading
                            a file moves it - Explorer's own thumbnailer, the indexer, the
                            antivirus scanner. A run set it correctly and it was measured
                            moving 1.6 seconds later. Offering a field the app cannot make
                            hold is worse than not offering it.

                            Changed stays under Advanced. Explorer never shows it, so
                            leaving it alone surprises nobody.
                        -->
                        <CheckBox Content="Changed (NTFS)"
                                  Visibility="{x:Bind Workbench.ShowsAdvancedFields, Mode=OneWay}"
                                  IsChecked="{x:Bind Workbench.WriteChanged, Mode=TwoWay}"
                                  ToolTipService.ToolTip="A fourth timestamp Explorer never shows. Not every drive can store it." />
                    </StackPanel>

                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" Padding="16,8" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">
                <!--
                    IsBusy, not IsApplying. Reading the disk is the other long operation and
                    for a recursive drop it is the longer one: IsScanning was set on both
                    scan paths and bound to nothing at all, so "Read 45,000 files…" counted
                    up with no spinner and no way out, while FileScanner had been taking a
                    cancellation token the whole time.
                -->
                <ProgressRing Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0"
                              IsActive="{x:Bind Workbench.IsBusy, Mode=OneWay}"
                              Visibility="{x:Bind Workbench.IsBusy, Mode=OneWay}" />

                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                           Text="{x:Bind Workbench.ScanStatus, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource CaptionTextBlockStyle}" />

                <Button Grid.Column="2" Content="Cancel" Margin="0,0,8,0"
                        Command="{x:Bind Workbench.CancelRunCommand}"
                        Visibility="{x:Bind Workbench.IsBusy, Mode=OneWay}"
                        Height="{StaticResource CnChromeButtonHeight}" />

                <!--
                    History sits beside Undo last run because they are one feature at two
                    depths: Undo is the run you just regretted, History is the one from
                    Tuesday. They used to be at opposite ends of the window, History filed
                    with About as though it were app trivia rather than the way back.

                    Always enabled, even with nothing applied yet. A greyed-out History
                    teaches people the app has no undo; an empty one that says so teaches
                    them it does, and that they have not used it - which is why the window
                    it opens has an empty state of its own.
                -->
                <Button Grid.Column="3" Content="History" Margin="0,0,8,0"
                        Click="OnOpenHistory"
                        Height="{StaticResource CnChromeButtonHeight}"
                        ToolTipService.ToolTip="Every run Chronora has applied, and the way back. Undo works days later, not just straight after." />

                <!-- Undo sits beside Apply rather than in a menu, because the moment someone
                     wants it is the moment straight after the run they regret. -->
                <Button Grid.Column="4" Content="Undo last run" Margin="0,0,8,0"
                        Command="{x:Bind Workbench.UndoLastCommand}"
                        IsEnabled="{x:Bind Workbench.CanUndo, Mode=OneWay}"
                        Height="{StaticResource CnChromeButtonHeight}" />

                <!--
                    Export preview (CSV) used to sit here. It still exists and still says
                    the same thing - it replaced a "Dry run" button, because a dry run
                    beside a live preview quietly tells the user that the thing they have
                    been looking at might not be real - but it exports the preview of the
                    LIST, so it now lives in the list's own overflow. Moving it is what made
                    room for History without crowding Apply.
                -->
                <Button Grid.Column="6" Style="{StaticResource AccentButtonStyle}"
                        Content="{x:Bind Workbench.Summary.ApplyLabel, Mode=OneWay}"
                        Click="OnApply"
                        MinWidth="{StaticResource CnCommandButtonMinWidth}"
                        Height="{StaticResource CnChromeButtonHeight}" />
            </Grid>
        </Border>
    </Grid>
</Window>
