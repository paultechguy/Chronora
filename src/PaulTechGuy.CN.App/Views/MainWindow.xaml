<Window
    x:Class="PaulTechGuy.CN.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto">

        <Border x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="16,0">
            <TextBlock Text="Chronora"
                       VerticalAlignment="Center"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
        </Border>

        <StackPanel Grid.Row="1" Spacing="8" Margin="24" VerticalAlignment="Center">
            <TextBlock Text="Skeleton is running."
                       Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.DataDirectory, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       IsTextSelectionEnabled="True" />
        </StackPanel>

        <Border Grid.Row="2" Height="32" Padding="16,0">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Border>
    </Grid>
</Window>
