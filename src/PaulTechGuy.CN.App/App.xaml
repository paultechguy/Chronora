<Application
    x:Class="PaulTechGuy.CN.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Chronora uses the Windows accent the user chose, never a brand color of its
                own. Marqora learned this the hard way and the reasoning transfers: a
                ContentDialog is hosted in the popup root rather than under the window
                content, and it resolves the accent aliases once, so a custom accent leaves
                the app two-toned - your color in the window, the user's in every dialog.
                Chrome-only brushes belong in here; accent overrides do not.

                Merged AFTER XamlControlsResources on purpose: a ResourceDictionary is
                searched own-entries first, then merged dictionaries last-to-first, so
                anything defined here wins over the framework's copy of the same key.
            -->

            <!--
                Focus, in the user's accent.

                Not an accent override - the opposite. The rule above forbids Chronora
                having a colour of its OWN, because a ContentDialog resolves the accent
                aliases in the popup root and a brand colour leaves the app two-toned. This
                takes the colour the user already chose and spends it on chrome, which is
                what that rule says this file is for.

                Worth doing because the default focus rectangle is a black-on-white double
                border: correct, legible, and the single greyest thing in a window that is
                already very grey. Only the outer border moves; the inner one stays as it is,
                because it is what keeps the rectangle visible against the accent itself.
            -->
            <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="{ThemeResource SystemAccentColorLight2}" />

            <!-- Shared metrics, so that no button states its own size inline. -->
            <x:Double x:Key="CnChromeButtonHeight">34</x:Double>
            <x:Double x:Key="CnFormRowHeight">32</x:Double>
            <x:Double x:Key="CnCommandButtonMinWidth">96</x:Double>
            <x:Double x:Key="CnButtonGroupSpacing">8</x:Double>

            <!--
                The command deck. Three segments across the top of the window stating what
                is loaded, what the run will do, and what comes out.

                The card fill is CardBackgroundFillColorDefaultBrush - a stock Fluent token
                - and not a colour of Chronora's own. That is the rule at the top of this
                file being obeyed rather than worked around: a brand surface here would be
                fine, but it is one step from a brand ACCENT, and an accent override leaves
                every ContentDialog in the app two-toned. If the deck is ever branded, it is
                branded by redefining this one brush, never by touching the accent aliases.
            -->
            <Style x:Key="CnDeckCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12,8" />
            </Style>

            <!--
                SOURCE / RULE / RESULT. Small and quiet: orientation, not content - but in
                the accent rather than in grey, because three identical grey cards give the
                eye nothing to tell them apart by, and these labels are the only thing that
                does. Each carries a glyph in the same colour for the same reason.
            -->
            <Style x:Key="CnDeckCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="CnDeckCaptionGlyphStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--
                A count that is also the filter for the rows it counts.

                Transparent until checked, when the framework's own Checked state paints it
                in the SYSTEM accent. That is deliberate: the one place in the deck that
                needs to shout is the one place the accent rule already provides for.
            -->
            <!--
                Column labels that are also the sort control.

                Sized and coloured like a label rather than a button, because that is what
                it is: the click is a convenience on top of a caption, not a command anybody
                needs to find. The hover state the template already provides is what says it
                can be clicked at all.
            -->
            <Style x:Key="CnColumnHeaderStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />

                <!--
                    No horizontal padding, so the label's left edge is the column's left
                    edge and sits directly over the text it names.
                -->
                <Setter Property="Padding" Value="0,2" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="MinWidth" Value="0" />

                <!--
                    Left, NOT Stretch. A stretched header fills its whole column, and a
                    flyout hung off it opens centred on the column - which for the File
                    column is half the window away from the label that was clicked. Hugging
                    the content puts the menu under the word, where every other dropdown in
                    Windows puts it.
                -->
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>

            <!--
                A chip: a piece of state that is in force, saying so, with the way to
                dismiss it attached. Used for the two things that silently change what the
                list shows and what the run covers.
            -->
            <Style x:Key="CnChipStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlAltFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="8,1,2,1" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="CnChipCloseStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="CornerRadius" Value="9" />
            </Style>

            <Style x:Key="CnDeckFilterToggleStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
