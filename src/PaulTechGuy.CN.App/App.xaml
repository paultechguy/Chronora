<Application
    x:Class="PaulTechGuy.CN.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Chronora uses the Windows accent the user chose, never a brand color of its
                own. Marqora learned this the hard way and the reasoning transfers: a
                ContentDialog is hosted in the popup root rather than under the window
                content, and it resolves the accent aliases once, so a custom accent leaves
                the app two-toned - your color in the window, the user's in every dialog.
                Chrome-only brushes belong in here; accent overrides do not.

                Merged AFTER XamlControlsResources on purpose: a ResourceDictionary is
                searched own-entries first, then merged dictionaries last-to-first, so
                anything defined here wins over the framework's copy of the same key.
            -->

            <!-- Shared metrics, so that no button states its own size inline. -->
            <x:Double x:Key="CnChromeButtonHeight">34</x:Double>
            <x:Double x:Key="CnFormRowHeight">32</x:Double>
            <x:Double x:Key="CnCommandButtonMinWidth">96</x:Double>
            <x:Double x:Key="CnButtonGroupSpacing">8</x:Double>

            <!--
                The command deck. Three segments across the top of the window stating what
                is loaded, what the run will do, and what comes out.

                The card fill is CardBackgroundFillColorDefaultBrush - a stock Fluent token
                - and not a colour of Chronora's own. That is the rule at the top of this
                file being obeyed rather than worked around: a brand surface here would be
                fine, but it is one step from a brand ACCENT, and an accent override leaves
                every ContentDialog in the app two-toned. If the deck is ever branded, it is
                branded by redefining this one brush, never by touching the accent aliases.
            -->
            <Style x:Key="CnDeckCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12,8" />
            </Style>

            <!-- SOURCE / RULE / RESULT. Small and quiet: orientation, not content. -->
            <Style x:Key="CnDeckCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Opacity" Value="0.55" />
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>

            <!--
                A count that is also the filter for the rows it counts.

                Transparent until checked, when the framework's own Checked state paints it
                in the SYSTEM accent. That is deliberate: the one place in the deck that
                needs to shout is the one place the accent rule already provides for.
            -->
            <Style x:Key="CnDeckFilterToggleStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
